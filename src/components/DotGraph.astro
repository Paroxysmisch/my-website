---
import { ramp } from "../lib/ramp";

interface Props {
  data: { label: string; value: number }[];
  title: string;
  unit: string;
  rows?: number;
}
const { data, title, unit, rows = 8 } = Astro.props;
const colW = 48;
const pitchY = 12;
const dotsPerCol = 3;
const r = 3.5;
const max = Math.max(1, ...data.map((d) => d.value));
const width = data.length * colW;
const height = rows * pitchY;
---
<figure class="dotgraph">
  <figcaption class="mono muted">{title} · peak {max} {unit}</figcaption>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    style={`width:100%;max-width:${Math.max(width, 288) * 1.25}px`}
    role="img"
    aria-label={`${title}: ${data.map((d) => `${d.label} ${d.value}`).join(", ")}`}
  >
    {data.map((d, ci) => {
      const n = d.value > 0 ? Math.max(1, Math.round((d.value / max) * rows)) : 0;
      return Array.from({ length: n }, (_, ri) =>
        Array.from({ length: dotsPerCol }, (_, di) => (
          <circle
            cx={ci * colW + (colW - (dotsPerCol - 1) * 12) / 2 + di * 12}
            cy={height - pitchY / 2 - ri * pitchY}
            r={r}
            fill={ramp(rows > 1 ? ri / (rows - 1) : 1)}
          />
        )),
      );
    })}
  </svg>
  <div class="axis num" aria-hidden="true">
    {data.map((d) => <span>{d.label}</span>)}
  </div>
  <table class="sr-only">
    <caption>{title}</caption>
    <thead><tr><th>Year</th><th>{unit}</th></tr></thead>
    <tbody>{data.map((d) => <tr><td>{d.label}</td><td>{d.value}</td></tr>)}</tbody>
  </table>
</figure>

<style>
  .dotgraph {
    display: grid;
    gap: 6px;
  }
  svg {
    display: block;
  }
  .axis {
    display: flex;
    max-width: 100%;
  }
  .axis span {
    flex: 1;
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
  }
</style>
