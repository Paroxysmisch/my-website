---
interface Props {
  metric: string;
  unit: string;
  baselineLabel: string;
  series: { label: string; value: number }[];
}
const { metric, unit, baselineLabel, series } = Astro.props;
const max = Math.max(...series.map((s) => s.value));
---
<figure class="chart">
  <figcaption class="meta">{metric}</figcaption>
  <ul>
    {series.map((s) => (
      <li>
        <span>{s.label}</span>
        <span class="track">
          <span
            class="bar"
            style={`width:${(s.value / max) * 100}%;background:${s.label === baselineLabel ? "var(--faint)" : "var(--accent)"}`}
          ></span>
        </span>
        <span class="val">{s.value}{unit}</span>
      </li>
    ))}
  </ul>
</figure>
