---
interface Props {
  label: string;
  value: number;
  max: number;
}
const { label, value, max } = Astro.props;
---
<div
  class="meter"
  role="meter"
  aria-label={label}
  aria-valuemin={0}
  aria-valuemax={max}
  aria-valuenow={value}
  aria-valuetext={`${value} of ${max}`}
>
  <span style={`width:${max > 0 ? (value / max) * 100 : 0}%`}></span>
</div>
