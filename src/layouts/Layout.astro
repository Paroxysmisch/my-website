---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  scene?: boolean;
}
const { title, description, scene = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1115" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {scene && <script>import "../scene/loader";</script>}
    <script>
      // Scroll-driven text motion only starts once the visitor scrolls: the first paint is fully static.
      addEventListener(
        "scroll",
        () => document.documentElement.classList.add("motion"),
        { once: true, passive: true },
      );

      // Section snapping: a fast flick settles on the next/previous section; slow scrolling stays free.
      {
        const secs = [...document.querySelectorAll<HTMLElement>("section[data-chapter]")];
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let startY = -1;
        let lastY = scrollY;
        let lastT = performance.now();
        let peak = 0;
        let idle = 0;
        let anim = 0;
        let animating = false;
        const tops = () => secs.map((el) => Math.max(0, Math.round(el.getBoundingClientRect().top + scrollY)));
        const cancel = () => {
          if (!animating) return;
          cancelAnimationFrame(anim);
          animating = false;
          startY = -1;
          lastY = scrollY;
          endJump();
        };
        // while we glide to a section the 3D scene heads straight for the destination chapter
        const sync = () => dispatchEvent(new Event("scroll"));
        const endJump = () => {
          const w = window as unknown as { __jump?: number };
          if (w.__jump !== undefined) {
            w.__jump = undefined;
            sync();
          }
        };
        const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
        const glide = (to: number, chapter: number) => {
          (window as unknown as { __jump?: number }).__jump = chapter;
          sync();
          const from = scrollY;
          const dur = Math.min(950, Math.max(520, Math.abs(to - from) * 0.45));
          const t0 = performance.now();
          animating = true;
          const step = (now: number) => {
            const p = Math.min(1, (now - t0) / dur);
            scrollTo(0, from + (to - from) * ease(p));
            if (p < 1) anim = requestAnimationFrame(step);
            else {
              animating = false;
              startY = -1;
              lastY = scrollY;
              endJump();
            }
          };
          anim = requestAnimationFrame(step);
        };
        for (const ev of ["wheel", "touchstart", "mousedown", "keydown"]) addEventListener(ev, cancel, { passive: true });
        // nav / anchor jumps glide to the section (no scroll-padding offset, no accidental snap afterwards)
        document.addEventListener("click", (e) => {
          const a = (e.target as Element).closest?.('a[href^="#"]') as HTMLAnchorElement | null;
          if (!a) return;
          const id = a.getAttribute("href")?.slice(1);
          const i = secs.findIndex((el) => el.id === id);
          if (i < 0) return;
          e.preventDefault();
          a.closest("details")?.removeAttribute("open");
          cancel();
          const max = document.documentElement.scrollHeight - innerHeight;
          const to = Math.min(tops()[i] as number, max);
          history.replaceState(null, "", `#${id}`);
          if (reduce) {
            scrollTo(0, to);
            return;
          }
          glide(to, i);
        });
        addEventListener(
          "scroll",
          () => {
            if (reduce || animating) return;
            const now = performance.now();
            if (startY < 0) {
              startY = lastY;
              peak = 0;
            }
            const dt = Math.max(1, now - lastT);
            peak = Math.max(peak, Math.abs(scrollY - lastY) / dt);
            lastY = scrollY;
            lastT = now;
            clearTimeout(idle);
            idle = window.setTimeout(() => {
              const dy = scrollY - startY;
              startY = -1;
              if (Math.abs(dy) < 90 || peak < 1.4) return;
              const ts = tops();
              const max = document.documentElement.scrollHeight - innerHeight;
              // gravitate to the section top nearest to where the scroll ran out of energy
              let idx = 0;
              ts.forEach((y, k) => {
                if (Math.abs(y - scrollY) < Math.abs((ts[idx] as number) - scrollY)) idx = k;
              });
              const target = Math.min(ts[idx] as number, max);
              if (Math.abs(target - scrollY) > innerHeight * 0.55 || Math.abs(target - scrollY) < 24) return;
              glide(target, idx);
            }, 140);
          },
          { passive: true },
        );
      }
      // Browsers without scroll-driven animations: fade text out by hand as it crosses the animation (phones).
      if (!CSS.supports("animation-timeline", "view()")) {
        const phone = matchMedia("(max-width: 1024px)");
        let fr = 0;
        const fade = () => {
          const vh = innerHeight;
          const end = vh * 0.46;
          const span = Math.min(140, vh * 0.15);
          for (const el of document.querySelectorAll<HTMLElement>(".rv")) {
            if (!phone.matches) {
              el.style.opacity = "";
              continue;
            }
            const b = el.getBoundingClientRect().bottom;
            el.style.opacity = b < end + span ? String(Math.max(0, (b - end) / span)) : "";
          }
        };
        addEventListener("scroll", () => {
          cancelAnimationFrame(fr);
          fr = requestAnimationFrame(fade);
        }, { passive: true });
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      const items = [...document.querySelectorAll<HTMLElement>(".rv")];
      for (const el of items) io.observe(el);
      // fallback path: anything scrolled (or jumped) past stays revealed
      let tick = 0;
      addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(tick);
          tick = requestAnimationFrame(() => {
            for (const el of items) {
              if (!el.classList.contains("in") && el.getBoundingClientRect().bottom < 0) el.classList.add("in");
            }
          });
        },
        { passive: true },
      );
    </script>
  </body>
</html>
