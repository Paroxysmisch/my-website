---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  scene?: boolean;
}
const { title, description, scene = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1115" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {scene && <script>import "../scene/loader";</script>}
    <script>
      // Scroll-driven text motion only starts once the visitor scrolls: the first paint is fully static.
      addEventListener(
        "scroll",
        () => document.documentElement.classList.add("motion"),
        { once: true, passive: true },
      );
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      const items = [...document.querySelectorAll<HTMLElement>(".rv")];
      for (const el of items) io.observe(el);
      // fallback path: anything scrolled (or jumped) past stays revealed
      let tick = 0;
      addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(tick);
          tick = requestAnimationFrame(() => {
            for (const el of items) {
              if (!el.classList.contains("in") && el.getBoundingClientRect().bottom < 0) el.classList.add("in");
            }
          });
        },
        { passive: true },
      );
    </script>
  </body>
</html>
