---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  scene?: boolean;
}
const { title, description, scene = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0f1012" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-pixel" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // choose the theme before first paint: the system's light/dark preference wins; without one, daytime (07–19h) = light.
      // ?theme=light|dark forces one for screenshots/tests.
      try {
        var auto = function () {
          try {
            if (matchMedia("(prefers-color-scheme: dark)").matches) return "dark";
            if (matchMedia("(prefers-color-scheme: light)").matches) return "light";
          } catch (e) {}
          var h = new Date().getHours();
          return h >= 7 && h < 19 ? "light" : "dark";
        };
        var q = new URLSearchParams(location.search).get("theme");
        localStorage.removeItem("theme");
        document.documentElement.dataset.theme = q === "light" || q === "dark" ? q : auto();
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {scene && <script>import "../scene/loader";</script>}
    <script>import "../scripts/page";</script>
  </body>
</html>
