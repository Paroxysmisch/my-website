---
import { getCollection } from "astro:content";
import ChapterNote from "../components/ChapterNote.astro";
import CopyButton from "../components/CopyButton.astro";
import Spark from "../components/Spark.astro";
import Meter from "../components/Meter.astro";
import ResultChart from "../components/ResultChart.astro";
import Layout from "../layouts/Layout.astro";
import { experience, getStats, news, profile, research } from "../lib/data";
import { loadPubs } from "../lib/pubs";

const pubs = loadPubs();
const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
const { stats, source } = await getStats();

const pubKeys = new Set(pubs.map((p) => p.key));
const projectIds = new Set(projects.map((p) => p.id));
for (const t of research) {
  for (const k of t.relatedPubKeys)
    if (!pubKeys.has(k)) throw new Error(`research.yaml: theme "${t.id}" references unknown pub "${k}"`);
  for (const id of t.relatedProjectIds)
    if (!projectIds.has(id)) throw new Error(`research.yaml: theme "${t.id}" references unknown project "${id}"`);
}
const totalItems = pubs.length + projects.length;

const paragraphs = profile.bioMarkdown.trim().split(/\n\s*\n/);
const fmtDate = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;

const nav = [
  ["about", "About"],
  ["research", "Research"],
  ["projects", "Projects"],
  ["publications", "Publications"],
  ["experience", "Experience"],
  ["news", "News"],
  ["contact", "Contact"],
] as const;
const year = new Date().getFullYear();
const isOwner = (a: string) => !!profile.bibName && a.toLowerCase() === profile.bibName.toLowerCase();
const bibHref = (p: (typeof pubs)[number]) => `data:text/plain;charset=utf-8,${encodeURIComponent(`${p.bibtex}\n`)}`;
const ym = (s: string) =>
  new Date(`${s}-01T00:00:00Z`).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const roles = [...experience].sort((a, b) => b.start.localeCompare(a.start));
const links = Object.entries({
  GitHub: profile.links.github,
  "Google Scholar": profile.links.scholar,
  ORCID: profile.links.orcid,
  LinkedIn: profile.links.linkedin,
  "CV (PDF)": profile.links.cv,
}).filter(([, v]) => v) as [string, string][];
---
<Layout title={`${profile.name} — ${profile.title}`} description={profile.tagline} scene>
  <header class="site-header">
    <a class="brand" href="#hero">{profile.name}</a>
    <nav class="nav-desktop" aria-label="Sections">
      {nav.map(([id, label]) => <a href={`#${id}`}>{label.toLowerCase()}</a>)}
    </nav>
    <details class="menu-mobile">
      <summary aria-label="Menu">menu</summary>
      <nav aria-label="Sections (mobile)">
        {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </details>
  </header>

  <canvas id="bg" aria-hidden="true"></canvas>
  <div id="stage" aria-hidden="true">
    <img class="scene-poster" alt="" width="1280" height="800" fetchpriority="low" decoding="async" hidden />
    <canvas id="scene"></canvas>
    <div class="scrim"></div>
    <div class="labels"></div>
    <div id="hud"></div>
  </div>
  <div id="info">
    <button type="button" id="info-btn" aria-expanded="false" aria-controls="beat" aria-label="About this animation">i</button>
    <p id="beat" role="status"></p>
  </div>

  <main id="main">
    <section id="hero" class="chapter hero" data-chapter="0" aria-labelledby="name">
      <div class="col">
        <ChapterNote index={0} part="kicker" />
        <h1 id="name" class="rv">{profile.name}</h1>
        <p class="lead rv">{profile.tagline}</p>
        <p class="meta rv">{profile.title} · {profile.affiliation}</p>
        <ul class="links-row rv">
          {links.map(([label, href]) => <li><a href={href}><span class="arrow">{label}</span></a></li>)}
        </ul>
        <ChapterNote index={0} part="caption" />
        <p class="scroll-hint rv" aria-hidden="true">scroll ↓</p>
      </div>
    </section>

    <section id="about" class="chapter" data-chapter="1" aria-labelledby="about-h">
      <div class="col">
        <ChapterNote index={1} part="kicker" />
        <h2 id="about-h" class="rv">About</h2>
        <ChapterNote index={1} part="caption" />
        <div class="prose">
          {paragraphs.map((p) => <p class="rv">{p}</p>)}
        </div>
        <dl class="facts rv">
          <div><dt>Affiliation</dt><dd>{profile.affiliation}</dd></div>
          {profile.advisor && <div><dt>Advisor</dt><dd>{profile.advisor}</dd></div>}
        </dl>
        <div class="stats rv">
          <dl class="stat-nums">
            <div><dt>papers</dt><dd>{stats.papers}</dd></div>
            <div><dt>citations</dt><dd>{stats.citations}</dd></div>
            <div><dt>h-index</dt><dd>{stats.hIndex}</dd></div>
          </dl>
          <Spark
            title="citations per year"
            unit="citations"
            data={stats.citationsByYear.slice(-8).map((c) => ({ label: String(c.year), value: c.count }))}
          />
          <p class="meta">source: {source}</p>
        </div>
      </div>
    </section>

    <section id="research" class="chapter" data-chapter="2" aria-labelledby="research-h">
      <div class="col">
        <ChapterNote index={2} part="kicker" />
        <h2 id="research-h" class="rv">Research</h2>
        <ChapterNote index={2} part="caption" />
        <div class="list">
          {research.map((t) => {
            const papers = t.relatedPubKeys.length;
            const projs = t.relatedProjectIds.length;
            return (
              <article class="item">
                <h3 class="rv">{t.title}</h3>
                <p class="rv">{t.summary}</p>
                <div class="rv"><Meter label={`${t.title}: papers and projects`} value={papers + projs} max={totalItems} /></div>
                <p class="meta rv">{plural(papers, "paper")} · {plural(projs, "project")}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section id="projects" class="chapter" data-chapter="3" aria-labelledby="projects-h">
      <div class="col">
        <ChapterNote index={3} part="kicker" />
        <h2 id="projects-h" class="rv">Projects</h2>
        <ChapterNote index={3} part="caption" />
        <div class="list">
          {projects.map((p) => (
            <article class="item">
              <p class="meta rv">{p.data.year}</p>
              <h3 class="rv">{p.data.title}</h3>
              <p class="rv">{p.data.summary}</p>
              {p.data.result && <div class="rv"><ResultChart {...p.data.result} /></div>}
              <div class="tags rv">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
              <div class="links-row rv">
                {p.data.links.paper && <a href={p.data.links.paper}><span class="arrow">paper</span></a>}
                {p.data.links.code && <a href={p.data.links.code}><span class="arrow">code</span></a>}
                {p.data.links.demo && <a href={p.data.links.demo}><span class="arrow">demo</span></a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="publications" class="chapter" data-chapter="4" aria-labelledby="pubs-h">
      <div class="col">
        <ChapterNote index={4} part="kicker" />
        <h2 id="pubs-h" class="rv">Publications</h2>
        <ChapterNote index={4} part="caption" />
        <ol class="list">
          {pubs.map((p) => (
            <li class="pub">
              <span class="year rv">{p.year}</span>
              <div>
                <h3 class="rv">{p.title}</h3>
                <p class="authors rv">
                  {p.authors.map((a, i) => (
                    <>
                      {isOwner(a) ? <strong>{a}</strong> : a}
                      {i < p.authors.length - 1 ? ", " : ""}
                    </>
                  ))}
                </p>
                <div class="row rv">
                  <span class="venue">{p.venue}</span>
                  {p.pdf && <a class="chip-link" href={p.pdf}>pdf</a>}
                  <a class="chip-link" href={bibHref(p)} download={`${p.key}.bib`}>bibtex</a>
                  {p.code && <a class="chip-link" href={p.code}>code</a>}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="experience" class="chapter" data-chapter="5" aria-labelledby="exp-h">
      <div class="col">
        <ChapterNote index={5} part="kicker" />
        <h2 id="exp-h" class="rv">Experience</h2>
        <ChapterNote index={5} part="caption" />
        <ol class="list">
          {roles.map((r) => (
            <li class="role">
              <span class="when rv">{ym(r.start)} – {r.end ? ym(r.end) : "present"}</span>
              <h3 class="rv">{r.role} <span class="org">· {r.org}</span></h3>
              <span class="lane rv">{r.lane.toLowerCase()}</span>
              <p class="rv">{r.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="news" class="chapter" data-chapter="6" aria-labelledby="news-h">
      <div class="col">
        <ChapterNote index={6} part="kicker" />
        <h2 id="news-h" class="rv">News, talks &amp; awards</h2>
        <ChapterNote index={6} part="caption" />
        <ul class="news">
          {news.slice(0, 8).map((n) => (
            <li>
              <time class="rv" datetime={n.date}>{fmtDate(n.date)}</time>
              <span class="rv">{n.text}{n.link && <> <a href={n.link}>link</a></>}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="contact" class="chapter" data-chapter="7" aria-labelledby="contact-h">
      <div class="col">
        <ChapterNote index={7} part="kicker" />
        <h2 id="contact-h" class="rv">Contact</h2>
        <ChapterNote index={7} part="caption" />
        <p class="rv"><a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <div class="rv"><CopyButton text={profile.email} label="Copy email" /></div>
        <ul class="links-row rv">
          {links.map(([label, href]) => <li><a href={href}><span class="arrow">{label}</span></a></li>)}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>© {year} {profile.name}</span>
  </footer>
</Layout>
