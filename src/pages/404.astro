---
import Layout from "../layouts/Layout.astro";
---
<Layout title="404 — Page not found" description="Page not found">
  <main id="main" class="nf">
    <h1>404</h1>
    <p class="mono">cudaErrorInvalidValue: no page exists at this address</p>
    <p><a class="link-btn" href={import.meta.env.BASE_URL}>Back to home</a></p>
  </main>
</Layout>

<style>
  .nf {
    max-width: 640px;
    margin: 0 auto;
    padding: 20vh 20px;
    display: grid;
    gap: 20px;
    justify-items: start;
  }
</style>
